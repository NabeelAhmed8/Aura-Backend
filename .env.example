# Port (Railway automatically injects PORT, default fallback: 5001)
PORT=5001
NODE_ENV=production

# MongoDB Connection String
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/Aura?retryWrites=true&w=majority

# Frontend URL (GitHub Pages, Vercel, or Localhost)
FRONTEND_URL=https://your-frontend-domain.github.io/aura-frontend

# Optional: Extra allowed origins separated by commas
ALLOWED_ORIGINS=https://your-frontend-domain.github.io

# Backend Public URL (Railway service public domain)
BACKEND_URL=https://your-app-name.up.railway.app

# JWT Secret Key for authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# Stripe Payment Secret Key
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Safepay API Keys (if using)
SAFEPAY_API_KEY=your_safepay_api_key_here
SAFEPAY_WEBHOOK_SECRET=your_safepay_webhook_secret_here

# Nodemailer Email Configuration (Gmail App Password or Custom SMTP)
# Delivers to ANY email recipient worldwide without requiring domain verification
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_SENDER_NAME=AURA Luxury

# Optional: Set to true if you want devOtp in API responses during local development
ALLOW_DEV_OTP=true
