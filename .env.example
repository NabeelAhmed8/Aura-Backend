# Port (Render automatically sets PORT in production, default fallback: 5001 or 10000)
PORT=5001
NODE_ENV=production

# MongoDB Connection String (Render pe MongoDB Atlas cloud URI zaroori hai, localhost kaam nahi karega)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/Aura?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/Aura?retryWrites=true&w=majority

# Frontend URL (Aapki deployed frontend website ka link, e.g. Vercel ya Netlify URL)
# Example: https://aura-clothing.vercel.app
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Optional: Extra allowed origins separated by commas
# Example: https://aura-frontend.vercel.app,https://admin.auraclothing.com
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

# Backend Public URL (Render web service URL)
# Example: https://aura-backend.onrender.com
BACKEND_URL=https://your-backend-app.onrender.com

# JWT Secret Key for authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# Stripe Payment Secret Key (sk_test_... ya live key sk_live_...)
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Safepay API Keys (if using)
SAFEPAY_API_KEY=your_safepay_api_key_here
SAFEPAY_WEBHOOK_SECRET=your_safepay_webhook_secret_here

# Email Verification (Nodemailer - Gmail App Password / Custom SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_16_char_app_password
