# Port (Railway automatically injects PORT, default fallback: 5001)
PORT=5001
NODE_ENV=production

# MongoDB Connection String
# Railway option 1: Agar Railway pe hi "New -> Database -> Add MongoDB" karein, toh Railway automatically MONGO_URL de deta hai.
# Railway option 2: MongoDB Atlas connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/Aura?retryWrites=true&w=majority

# Frontend URL (GitHub Pages ya Vercel URL)
# Example: https://nabeelahmed8.github.io/aura-frontend
FRONTEND_URL=https://your-frontend-domain.github.io/aura-frontend

# Optional: Extra allowed origins separated by commas
ALLOWED_ORIGINS=https://your-frontend-domain.github.io

# Backend Public URL (Railway service public domain)
# Example: https://aura-backend-production.up.railway.app
BACKEND_URL=https://your-app-name.up.railway.app

# JWT Secret Key for authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# Stripe Payment Secret Key (sk_test_... ya live key sk_live_...)
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Safepay API Keys (if using)
SAFEPAY_API_KEY=your_safepay_api_key_here
SAFEPAY_WEBHOOK_SECRET=your_safepay_webhook_secret_here

# Email Verification (Nodemailer - Gmail App Password / Custom SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_16_char_app_password
